# ─── Contact form (existing) ────────────────────────────────────────────────
# Formspree / Web3Forms endpoint. Leave blank to show the "not configured" notice.
VITE_FORM_ENDPOINT=

# ─── Supabase (event platform) ──────────────────────────────────────────────
# Both are PUBLIC and ship in the JS bundle. RLS is what protects your data.
# Without these the marketing site still runs and /events shows demo data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: overrides window.location.origin for OAuth redirects.
VITE_SITE_URL=

# ─── NEVER put these in a VITE_ var ─────────────────────────────────────────
# They belong in Supabase Edge Function secrets (`supabase secrets set`):
#   SUPABASE_SERVICE_ROLE_KEY   (bypasses all RLS — total compromise if leaked)
#   RAZORPAY_KEY_SECRET
#   RAZORPAY_WEBHOOK_SECRET
#   ALLOWED_ORIGINS
